{
  "name": "iobroker.backitup",
  "version": "4.0.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "ioBroker.backitup allows you to backup and restore your ioBroker installation and other systems, such as databases, Zigbee, scripts and many more.",
  "author": {
    "name": "simatec",
    "email": "backitup@simateccloud.de"
  },
  "contributors": [
    {
      "name": "simatec",
      "email": "backitup@simateccloud.de"
    },
    {
      "name": "bluefox",
      "email": "dogafox@gmail.com"
    }
  ],
  "homepage": "https://github.com/simatec/ioBroker.backitup",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "ioBroker.backitup",
    "Smart Home",
    "home automation",
    "Backup",
    "iob",
    "Homematic",
    "Grafana",
    "Zigbee",
    "MySql",
    "InfluxDB",
    "Onedrive",
    "GoogleDrive",
    "Dropbox",
    "WebDav",
    "NFS",
    "CIFS",
    "FTP",
    "NAS",
    "Backitup",
    "JavaScript",
    "Restore",
    "Redis",
    "Node-Red",
    "Yahka"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/simatec/ioBroker.backitup"
  },
  "dependencies": {
    "@esm2cjs/got": "^13.0.0",
    "@googleapis/drive": "^22.0.0",
    "@iobroker/adapter-core": "^3.4.3",
    "@iobroker/js-controller-common": "^7.2.2",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "cron-parser": "^5.10.0",
    "dropbox-v2-api": "^2.5.12",
    "express": "^5.2.1",
    "fs-extra": "^11.4.0",
    "ftp": "^0.3.10",
    "google-auth-library": "^11.0.2",
    "mqtt": "^5.15.2",
    "multer": "^2.2.0",
    "node-schedule": "^2.1.1",
    "node-wol": "^0.1.1",
    "tar-fs": "^3.1.3",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.1",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@iobroker/types": "^7.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/ftp": "^0.3.36",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/node-schedule": "^2.1.8",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "!admin/**/*.map",
    "admin{,/!(i18n)/**}/flat.txt",
    "docs/",
    "build/",
    "!build/**/*.map",
    "!CHANGELOG_OLD.md",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run test:package && npm run test:types && npm run test:unit",
    "test:package": "mocha test/package --exit",
    "test:types": "mocha test/types --exit",
    "test:unit": "mocha test/unit --exit",
    "test:integration": "mocha test/integration --exit",
    "prepublishOnly": "npm run build",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "translate": "translate-adapter",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-tab && npx -y npm-check-updates --upgrade && cd ../src-admin && npx -y npm-check-updates --upgrade",
    "npm": "npm i && cd src-tab && npm i -f && cd ../src-admin && npm i -f",
    "dev-server-run": "dev-server run backitup",
    "dev-server-watch": "dev-server watch -x backitup",
    "dev-server-upload": "dev-server upload backitup",
    "admin-0-clean": "node tasks --admin-0-clean",
    "admin-1-npm": "node tasks --admin-1-npm",
    "admin-2-compile": "node tasks --admin-2-compile",
    "admin-3-copy": "node tasks --admin-3-copy",
    "admin-build": "node tasks --admin-build",
    "0-clean": "node tasks --0-clean",
    "1-npm": "node tasks --1-npm",
    "2-build": "node tasks --2-build",
    "3-copy": "node tasks --3-copy",
    "4-patch": "node tasks --4-patch",
    "build:backend": "tsc -p tsconfig.build.json",
    "check-ts": "tsc -p tsconfig.json",
    "build": "node tasks && npm run build:backend",
    "lint": "eslint -c eslint.config.mjs",
    "lint-frontend": "cd src-admin && eslint -c eslint.config.mjs && cd ../src-tab && eslint -c eslint.config.mjs"
  },
  "bugs": {
    "url": "https://github.com/simatec/ioBroker.backitup/issues"
  },
  "readmeFilename": "README.md"
}
